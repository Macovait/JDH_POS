# ===============================
# Jakababa POS - SaaS Environment (XAMPP Development)
# ===============================
# Copy this file to .env and adjust values for your installation.
# Each tenant uses the same database but is isolated by tenant_id.

# ----------------------------------------------------------------------
# Application Configuration
# ----------------------------------------------------------------------
APP_ENV=development
APP_DEBUG=true
APP_TIMEZONE=Africa/Nairobi
APP_NAME=JAKPOS
APP_VERSION=2.0.0

# Base URL – for XAMPP, use localhost with your project folder
# Example: http://localhost/JDH_POS/public
APP_URL=http://localhost/JDH_POS/public/

# Disable subdomain routing for local development
APP_USE_SUBDOMAINS=false

# ----------------------------------------------------------------------
# Database Configuration (shared by all tenants)
# ----------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=jdh_pos
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4
DB_TIMEZONE=+03:00

# ----------------------------------------------------------------------
# Security
# ----------------------------------------------------------------------
# REQUIRED: Generate a unique key for your installation.
# Run: php -r "echo bin2hex(random_bytes(32));"
# NEVER commit the real key to version control.
ENCRYPTION_KEY=

# Session Configuration
SESSION_TIMEOUT=1800                       # seconds (30 minutes)
SESSION_WARNING_TIME=300                   # seconds (5 minutes before timeout)
SESSION_CHECK_INTERVAL=10                  # seconds between checks
SESSION_COOKIE_NAME=jakababa_saas_sid
SESSION_REGENERATE_INTERVAL=1800           # seconds (30 minutes)

# CSRF Protection
CSRF_ENABLED=true
CSRF_TOKEN_LIFETIME=3600                   # seconds (1 hour)

# Password Policy
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SYMBOLS=true
PASSWORD_HISTORY_COUNT=5                   # Prevent reusing last 5 passwords
PASSWORD_PREVENT_COMMON=true               # Block common weak passwords

# Rate Limiting
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW=900               # seconds (15 minutes)
RATE_LIMIT_API_REQUESTS=100
RATE_LIMIT_API_WINDOW=60                  # seconds (1 minute)

# Brute Force Protection
BRUTE_FORCE_ENABLED=true
BRUTE_FORCE_MAX_ATTEMPTS=5
BRUTE_FORCE_LOCKOUT_DURATION=1800         # seconds (30 minutes)
BRUTE_FORCE_LOCKOUT_MULTIPLIER=2

# Audit Logging
AUDIT_LOGGING_ENABLED=true
AUDIT_RETENTION_DAYS=90
AUDIT_SENSITIVE_FIELDS=password,ssn,credit_card,token

# Data Access Scope
ENFORCE_TENANT_ISOLATION=true
ENFORCE_BRANCH_ISOLATION=true
DATA_ACCESS_STRICT_MODE=true

# Redis (for rate limiting and caching)
REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Login Security (legacy)
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_TIME=900                    # seconds (15 minutes)

# ----------------------------------------------------------------------
# Email / SMTP
# ----------------------------------------------------------------------
ADMIN_EMAIL=admin@jakababa.com
EMAIL_FROM=noreply@jakababa.com
EMAIL_FROM_NAME=JAKPOS System

# SMTP Configuration (for production)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ENCRYPTION=tls

# Backup Email
BACKUP_EMAIL=backup@jakababa.com
BACKUP_RETENTION_DAYS=30

# ----------------------------------------------------------------------
# Plan Limits (Subscription Tiers)
# ----------------------------------------------------------------------
PLAN_FREE_MAX_USERS=1
PLAN_FREE_MAX_PRODUCTS=100
PLAN_FREE_MAX_BRANCHES=1
PLAN_FREE_STORAGE=1                      # GB

PLAN_STARTER_MAX_USERS=3
PLAN_STARTER_MAX_PRODUCTS=1000
PLAN_STARTER_MAX_BRANCHES=1
PLAN_STARTER_STORAGE=5                   # GB

PLAN_PRO_MAX_USERS=unlimited
PLAN_PRO_MAX_PRODUCTS=unlimited
PLAN_PRO_MAX_BRANCHES=unlimited
PLAN_PRO_STORAGE=50                      # GB

# ----------------------------------------------------------------------
# Business Settings
# ----------------------------------------------------------------------
DEFAULT_CURRENCY=KES
DEFAULT_TAX_RATE=16
DEFAULT_PLAN_ID=1                        # ID of the free plan in plans table

# Registration Settings
ALLOW_SELF_REGISTER=true                 # Allow users to register themselves
ALLOW_TENANT_REGISTER=true               # Allow new tenants to register

# ----------------------------------------------------------------------
# File Uploads
# ----------------------------------------------------------------------
MAX_FILE_SIZE=10485760                   # 10 MB
ALLOWED_UPLOAD_EXTENSIONS=jpg,jpeg,png,gif,pdf,doc,docx,xls,xlsx

# ----------------------------------------------------------------------
# Cache Configuration
# ----------------------------------------------------------------------
CACHE_ENABLED=true
CACHE_LIFETIME=3600                      # seconds (1 hour)
CACHE_DRIVER=file                        # file, redis, memcached
CACHE_PREFIX=jakababa_

# ----------------------------------------------------------------------
# Logging
# ----------------------------------------------------------------------
LOG_ERRORS=true
LOG_LEVEL=debug                          # debug, info, warning, error

# ----------------------------------------------------------------------
# Maintenance Mode
# ----------------------------------------------------------------------
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=System under maintenance. Please check back later.

# ----------------------------------------------------------------------
# API Configuration
# ----------------------------------------------------------------------
API_RATE_LIMIT=1000                      # requests per window
API_RATE_LIMIT_WINDOW=3600               # seconds (1 hour)
API_DEFAULT_SCOPE=read

# CORS — Comma-separated allowed origins (set * for development only)
# Example: https://shop.example.com,https://admin.example.com
API_ALLOWED_ORIGINS=*
STOREFRONT_URL=http://localhost:3000

# ----------------------------------------------------------------------
# Payment Gateways
# ----------------------------------------------------------------------

# M-Pesa Configuration
MPESA_ENABLED=true
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_ENVIRONMENT=sandbox               # sandbox or production

# Stripe Configuration
STRIPE_ENABLED=false
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Flutterwave Configuration
FLUTTERWAVE_ENABLED=false
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=

# PayPal Configuration
PAYPAL_ENABLED=false
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox              # sandbox or production

# ----------------------------------------------------------------------
# SMS Configuration (Africa's Talking)
# ----------------------------------------------------------------------
SMS_ENABLED=false
SMS_PROVIDER=africastalking             # africastalking, twilio
SMS_API_KEY=
SMS_USERNAME=
SMS_SENDER_ID=JAKPOS
SMS_API_URL=

# ----------------------------------------------------------------------
# Third-Party Services
# ----------------------------------------------------------------------

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Facebook OAuth
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=

# hCaptcha (for bot protection)
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET_KEY=

# HaveIBeenPwned API (for breached password detection)
HIBP_API_KEY=

# ----------------------------------------------------------------------
# Brand Colors (overwrites for specific tenant)
# ----------------------------------------------------------------------
BRAND_PRIMARY=#f59e0b
BRAND_PRIMARY_DARK=#d97706
BRAND_PRIMARY_LIGHT=#fbbf24
BRAND_ACCENT=#f59e0b
BRAND_ACCENT_DARK=#d97706
BRAND_SUCCESS=#10b981
BRAND_WARNING=#f59e0b
BRAND_DANGER=#ef4444
BRAND_INFO=#3b82f6

# ----------------------------------------------------------------------
# Performance Tuning
# ----------------------------------------------------------------------
PHP_MEMORY_LIMIT=256M
PHP_MAX_EXECUTION_TIME=300
PHP_MAX_INPUT_VARS=1000

# ----------------------------------------------------------------------
# Development Only (not used in production)
# ----------------------------------------------------------------------
# Show detailed errors in development
DISPLAY_ERRORS=true

# Enable SQL query logging
LOG_QUERIES=false

# Fake email sending (development only)
MAIL_DRIVER=log                          # log, smtp, sendmail

# ----------------------------------------------------------------------
# Feature Flags
# ----------------------------------------------------------------------
FEATURE_MULTI_BRANCH=true
FEATURE_INVENTORY=true
FEATURE_REPORTS=true
FEATURE_LOYALTY=true
FEATURE_API_ACCESS=true
FEATURE_OFFLINE_MODE=false

# ----------------------------------------------------------------------
# GDPR & Compliance
# ----------------------------------------------------------------------
GDPR_ENABLED=true
COOKIE_CONSENT_ENABLED=true
DATA_RETENTION_DAYS=365

# ----------------------------------------------------------------------
# KRA eTIMS (Electronic Tax Invoice Management System)
# ----------------------------------------------------------------------
# Required for Kenyan businesses for tax compliance
# Register at https://etims.kra.go.ke to obtain credentials
ETIMS_ENABLED=false
ETIMS_ENVIRONMENT=sandbox                # sandbox or production
ETIMS_TIN=                               # KRA TIN (Tax Identification Number)
ETIMS_BRANCH_ID=00                       # KRA branch ID (00 = HQ)
ETIMS_DEVICE_SERIAL=                     # Device serial number from KRA
ETIMS_CMC_KEY=                           # Communication Key from KRA

# ----------------------------------------------------------------------
# Monitoring & Metrics
# ----------------------------------------------------------------------
# Token to protect /api/metrics.php endpoint (Prometheus-compatible)
# Generate: php -r "echo bin2hex(random_bytes(16));"
METRICS_TOKEN=

# ===============================
# End of Configuration
# ===============================