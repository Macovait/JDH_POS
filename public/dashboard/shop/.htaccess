# Remove restrictive CSP header so customize.php iframe preview works
Header unset Content-Security-Policy
Header unset X-Frame-Options

# Allow iframe loading of any storefront origin (e.g. Next.js dev server, CDN, or custom domain)
Header always set Content-Security-Policy "default-src 'self' 'unsafe-inline' 'unsafe-eval' https: data:; frame-src 'self' *; img-src 'self' data: http: https:; font-src 'self' https: data:; connect-src 'self' *; style-src 'self' 'unsafe-inline' https:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https:;"

# Enable rewrite engine
<IfModule mod_rewrite.c>
    RewriteEngine On
</IfModule>
